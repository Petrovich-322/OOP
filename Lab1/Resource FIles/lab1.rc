#include <framework.h>
#include "lab1_resource.h"

IDC_LAB1 MENU
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "E&xit",           IDM_EXIT
    END
    POPUP "Actions"
    BEGIN
        MENUITEM "Work1",           ID_ACTIONS_WORK1
        MENUITEM "Work2",           ID_ACTIONS_WORK2
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "&About ...",      IDM_ABOUT
    END
END

IDC_LAB1 ACCELERATORS
BEGIN
    "?", IDM_ABOUT, ASCII, ALT
    "/", IDM_ABOUT, ASCII, ALT
END

IDD_ABOUTBOX DIALOGEX 0, 0, 170, 62
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "About Lab1"
FONT 8, "MS Shell Dlg", 0, 0, 1
BEGIN
    LTEXT         "Lab1, Version 1.0", IDC_STATIC, 42, 14, 114, 8, SS_NOPREFIX
    LTEXT         "Copyright (c) 2026", IDC_STATIC, 42, 26, 114, 8
    DEFPUSHBUTTON "OK", IDOK, 113, 41, 50, 14, WS_GROUP
END

STRINGTABLE
BEGIN
    IDS_APP_TITLE "Lab1"
    IDC_LAB1      "LAB1"
END

#include "module1.rc"
#include "module2.rc"